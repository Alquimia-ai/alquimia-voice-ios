{
  "assistant_id": "alquimia-voice-demo",
  "nickname": "Alquimia Voice Demo",
  "description": "Voice-enabled agent: Groq Whisper STT, Groq gpt-oss-20b, Kokoro-FastAPI TTS behind an OpenAI-compatible endpoint.",
  "tags": [
    "voice",
    "demo",
    "ios"
  ],
  "audio": {
    "input_modalities": [
      "text",
      "audio"
    ],
    "output_modalities": [
      "text",
      "audio"
    ],
    "stt": {
      "provider_id": "openai/transcribe",
      "base_url": {
        "$secretRef": "STT_PROVIDER_BASE_URL"
      },
      "model": "whisper-large-v3-turbo",
      "api_key": {
        "$secretRef": "GROQ_API_KEY"
      }
    },
    "tts": {
      "provider_id": "openai/tts",
      "base_url": {
        "$secretRef": "TTS_PROVIDER_BASE_URL"
      },
      "model": "kokoro",
      "voice": "af_heart",
      "output_format": "wav",
      "api_key": {
        "$secretRef": "KOKORO_API_KEY"
      }
    }
  },
  "response": {
    "provider_id": "alquimia",
    "profile": {
      "prompt_clauses": {
        "identity": "You are Alquimia Voice, a spoken assistant for the Alquimia platform.",
        "personality": "Warm, precise and unhurried.",
        "purpose": "Hold a short spoken conversation and answer questions about Alquimia.",
        "knowledge": "",
        "rules": "Reply in the language the user speaks. Keep every answer to one or two short sentences, suitable for text-to-speech. Never use lists, markdown or code.",
        "response_format": "Plain conversational text."
      },
      "runtime_context": {
        "skills": {},
        "active_decorators": []
      },
      "evaluation_strategy": {
        "evaluation_strategy_id": "one-shoot"
      },
      "persistence_strategy": "INCREMENTAL"
    },
    "config": {
      "provider_id": "groq",
      "params": {
        "model": "openai/gpt-oss-20b",
        "temperature": 0.3,
        "api_key": {
          "$secretRef": "GROQ_API_KEY"
        }
      }
    }
  },
  "empathy": {
    "rules": []
  },
  "shields": {}
}
